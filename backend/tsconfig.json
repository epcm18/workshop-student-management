{
  "compilerOptions": {
    /* Basic */
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",

    /* Decorators (TypeORM needs these) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Type checking */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Source maps & declaration files */
    "sourceMap": true,
    "declaration": true,

    /* Node.js environment */
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
